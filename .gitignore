# Environment variables - NEVER commit sensitive data
.env
.env.local
.env.*.local

# NotebookLM MCP Server directory
servers/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
build/
dist/
servers/**/*.js
servers/**/*.js.map

# IDE
.vscode/*
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

